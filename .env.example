NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
# Your deployed origin, e.g. https://reporting.yourfund.com. NEXT_PUBLIC_SITE_URL is
# preferred; NEXT_PUBLIC_APP_URL is the older name and still honoured (lib/site-links.ts).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Legal pages linked from the footer and the sign-in pages. Leave unset and no link renders:
# a fund running its own deployment has its own terms, or none.
# NEXT_PUBLIC_TERMS_URL=
# NEXT_PUBLIC_PRIVACY_URL=

# ── Credentials (optional): keep keys out of the app and out of chat ──────────
# Every key a fund can save in Settings can be set here instead. A key saved in
# Settings wins; these fill in when Settings has none. They apply to every fund on
# this deployment, and take effect after a redeploy (or restart). The assistant's
# environment_status tool says which are set, never their values
# (lib/credentials/env.ts).
#
# AI providers (choose which runs with update_fund_connections or in Settings):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
#
# Outbound email, for the provider the fund selects. RESEND_API_KEY below is also
# the one Supabase Auth and the contact form use.
# POSTMARK_SERVER_TOKEN=
# MAILGUN_API_KEY=
#
# Inbound email over Mailgun: the webhook signing key.
# MAILGUN_WEBHOOK_SIGNING_KEY=
#
# Google Drive (OAuth client for file storage and memo export):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# If using Resend for Supabase Auth or email sending
RESEND_API_KEY=
CONTACT_EMAIL=                           
CONTACT_FROM=

# If using due diligence agent
CRON_SECRET=

# Set to "true" to seed demo data and disable email parsing
# DEMO_MODE=true

# Set to "true" to offer the destructive admin tools to connected assistants and
# the API: delete a company, LP investor, entity, commitment, deal room or dated
# LP positions; remove a team member; unpost, reverse or void a posted entry;
# merge investors or entities. (Reopening a closed period is always offered, and
# staged for an admin from chat.) Off by default: they are
# not listed and every call is refused. When on, every such call is staged and
# waits for an admin's approval, from any credential (lib/agent/destructive.ts).
# Deleting all fund data is never offered.
# AGENT_DESTRUCTIVE_ACTIONS=true

# Diligence call transcription (Deepgram). Optional unless you upload
# audio/video recordings; missing keys only break that one flow.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# No shared webhook secret: each transcription job mints its own single-use
# callback token, stored hashed on the job row (SEC-010). Nothing to configure.
# Optional override for the webhook base URL (set when a dev tunnel like
# ngrok is needed). Falls back to NEXT_PUBLIC_SITE_URL / VERCEL_URL.
# TRANSCRIPTION_WEBHOOK_URL=


# ── Installable app (PWA) ─────────────────────────────────────────────────
# The service worker is on by default and caches only static assets plus an
# offline notice — never a page or an API response (public/sw.js explains why).
# Set this to "true" to switch it off: it stops registration AND unregisters any
# worker already installed, so it is a complete way out without asking users to
# clear site data. NEXT_PUBLIC_*, so it needs a rebuild to take effect.
# NEXT_PUBLIC_DISABLE_SW=true
