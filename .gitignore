# Demo fixtures — local only, not part of the product.
#
# The demo fund is this install's marketing demo, not something another fund wants when they
# install this app. The generator lives on the machine that runs it; the demo fund's rows live in
# the database, which is the source of truth. `api/demo/seed` is listed in OPTIONAL_ROUTES
# (lib/access/route-domains.ts) so the route-coverage test doesn't call its registry entry stale
# when the file isn't here.
#
# NOTE: the demo SIGN-IN is not ignored and never should be — it's generic, with no install-specific content in it.
# It now lives in the `startDemo` server action (app/demo/actions.ts), which replaced the old
# /api/demo/credentials route. Nor is scripts/demo-agent-account.ts ignored, which is deliberately
# decoupled from these fixtures.
/lib/demo/
/app/api/demo/seed/
/scripts/run-demo-seed.ts

# Internal planning + thinking. Kept locally, not published.
/plans/

# local-only operational data — a vehicle registry names the firm, its funds and its SPVs
scripts/*.local.json

# The public demo widget is built by `npm run demo:widget` (and by CI, which publishes it).
/demo-widget/dist/
/demo-widget/check-report.json

# The fund engine builds to dist/ for publishing; the app consumes its source.
/packages/*/dist/

# Written by npm run upgrade -- --apply; paste it into the SQL editor, then delete it.
upgrade-*.sql
