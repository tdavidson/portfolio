# Auto detect text files and perform LF normalization
* text=auto

# Generated modules that a unit test compares byte-for-byte with a rebuild of their sources
# (lib/mcp-apps/generated.test.ts). The sources and the output keep LF on every platform, or a
# Windows checkout would fail that test without anything having changed.
*.generated.ts text eol=lf linguist-generated=true
plugin/** text eol=lf
lib/mcp-apps/app/** text eol=lf
app/globals.css text eol=lf

# The engine's sample close bundle: its manifest records the sha256 of each file's bytes, and
# lib/accounting/close-bundle.test.ts verifies them. Keep LF everywhere, or a Windows checkout
# rewrites the files to CRLF and the bundle no longer verifies.
packages/fund-engine/examples/bundle/** text eol=lf
