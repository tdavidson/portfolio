{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/inbound-email/route.ts": {
      "maxDuration": 120
    },
    "app/api/companies/*/summary/route.ts": {
      "maxDuration": 30
    },
    "app/api/emails/*/reprocess/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/deals-digest/route.ts": {
      "maxDuration": 120
    },
    "app/api/firm/style-anchors/route.ts": {
      "maxDuration": 60
    },
    "app/api/diligence/*/documents/from-drive/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/memo-agent-worker/route.ts": {
      "maxDuration": 300
    },
    "app/api/diligence/*/agent/render/route.ts": {
      "maxDuration": 60
    },
    "app/api/diligence/*/documents/from-affinity/route.ts": {
      "maxDuration": 120
    },
    "app/api/emails/*/accept-to-diligence/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/fee-periods/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/affinity-sync/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/deal-research/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/company-updates-ocr/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/entity-documents-ocr/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/company-updates-backfill/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/document-hashes/route.ts": {
      "maxDuration": 300
    },
    "app/api/company-updates/backfill/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/ops-reminders/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/tick/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/access-expiry/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 13 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "github": {
    "autoJobCancelation": true
  }
}
